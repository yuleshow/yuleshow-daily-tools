#!/usr/bin/env python3
"""Print IPTC Keywords and XMP Subject for images in a directory."""

import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    target = Path(sys.argv[1]) if len(sys.argv) > 1 else Path.cwd()
    if len(sys.argv) > 2:
        print("Usage: yuleshow-readtags [dir]", file=sys.stderr)
        return 1
    exiftool = shutil.which("exiftool")
    if not exiftool:
        print("exiftool not found", file=sys.stderr)
        return 1
    if not target.is_dir():
        print(f"Not a directory: {target}", file=sys.stderr)
        return 1

    print(f"🚀 Reading tags in: {target}")
    failed = False
    for image in sorted(path for path in target.rglob("*")
                        if path.is_file() and path.suffix.casefold()
                        in (".jpg", ".jpeg", ".png")):
        result = subprocess.run(
            [exiftool, "-s", "-XMP:Subject", "-IPTC:Keywords", str(image)],
            capture_output=True, text=True, check=False,
        )
        if result.returncode:
            print(f"❌ {image}: {result.stderr.strip()}", file=sys.stderr)
            failed = True
            continue
        values = {"Subject": [], "Keywords": []}
        for line in result.stdout.splitlines():
            label, separator, value = line.partition(":")
            if separator and label.strip() in values and value.strip():
                values[label.strip()].append(value.strip())
        print(f"📷 {image}")
        print(f"Subject  : {', '.join(values['Subject'])}")
        print(f"Keywords : {', '.join(values['Keywords'])}")
        print("---------------------------------------------")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
