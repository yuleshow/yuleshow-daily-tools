#!/usr/bin/env python3
"""Clean user caches and OS metadata from explicitly selected volumes."""

import argparse
import ctypes
import os
import shutil
import subprocess
import sys
from pathlib import Path


MAC_VOLUME_DIRS = (".DocumentRevisions-V100", ".Spotlight-V100", ".TemporaryItems",
                   ".Trashes", ".fseventsd")


def remove(path: Path, dry_run: bool) -> None:
    print(f"{'DRY-RUN: would remove' if dry_run else 'Removing'} {path}")
    if dry_run:
        return
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def run(command: list[str], dry_run: bool, **kwargs) -> int:
    print(f"{'DRY-RUN: ' if dry_run else ''}{subprocess.list2cmdline(command)}")
    if dry_run:
        return 0
    return subprocess.run(command, check=False, **kwargs).returncode


def volume_root(path: Path) -> bool:
    if sys.platform == "darwin":
        return path.parent == Path("/Volumes") and path != Path("/Volumes")
    if os.name == "nt":
        get_volume_path = ctypes.windll.kernel32.GetVolumePathNameW
        buffer = ctypes.create_unicode_buffer(32768)
        if not get_volume_path(str(path.resolve()), buffer, len(buffer)):
            return False
        root = Path(buffer.value)
        return path.resolve() == root
    return path != Path("/") and os.path.ismount(path)


def clean_volume(target: Path, dry_run: bool) -> bool:
    if not target.is_dir():
        print(f"⚠️ Not a directory, skipping: {target}", file=sys.stderr)
        return False
    if not volume_root(target):
        print(f"⚠️ Not a mounted volume root, skipping: {target}", file=sys.stderr)
        return False

    print(f"🚀 Cleaning volume: {target}")
    patterns = {".ds_store", "._*"}
    if os.name == "nt":
        patterns.add("thumbs.db")
    found = set()
    for pattern in patterns:
        for path in target.rglob(pattern):
            if path.is_file() and not path.is_symlink():
                found.add(path)
    if sys.platform == "darwin":
        dot_clean = shutil.which("dot_clean")
        if dot_clean and run([dot_clean, "-m", str(target)], dry_run):
            return False
    failed = False
    for path in sorted(found):
        try:
            remove(path, dry_run)
        except OSError as error:
            print(f"❌ Could not remove {path}: {error}", file=sys.stderr)
            failed = True
    if sys.platform == "darwin":
        for name in MAC_VOLUME_DIRS:
            path = target / name
            if os.path.lexists(path):
                try:
                    remove(path, dry_run)
                except OSError as error:
                    print(f"❌ Could not remove {path}: {error}", file=sys.stderr)
                    failed = True
    print(f"{'⚠️ Volume cleanup had errors' if failed else '✅ Volume cleanup complete'}: {target}")
    return not failed


def clean_system(dry_run: bool) -> bool:
    home = Path.home()
    failed = False
    print("🚀 Starting user system maintenance...")
    if sys.platform == "darwin":
        defaults = shutil.which("defaults")
        if defaults:
            for key in ("DSDontWriteNetworkStores", "DSDontWriteUSBStores"):
                failed |= run([defaults, "write", "com.apple.desktopservices", key,
                               "-bool", "true"], dry_run) != 0
        brew = shutil.which("brew")
        if brew:
            environment = os.environ.copy()
            environment["HOMEBREW_NO_AUTO_UPDATE"] = "1"
            failed |= run([brew, "cleanup", "-s"], dry_run, env=environment) != 0
        else:
            print("⚠️ Homebrew not found, skipping.")
        purge = shutil.which("purge")
        sudo = shutil.which("sudo")
        if purge and sudo:
            failed |= run([sudo, purge], dry_run) != 0
        adobe = home / "Library/Application Support/Adobe/Common"
        cache_paths = [adobe / name for name in
                       ("Media Cache", "Media Cache Files", "Peak Files", "PTX")]
        cache_paths.append(home / "Library/Caches")
        for directory in (home / "yuleshow-github", home / "Pictures"):
            dot_clean = shutil.which("dot_clean")
            if dot_clean and directory.is_dir():
                failed |= run([dot_clean, "-m", str(directory)], dry_run) != 0
    elif os.name == "nt":
        local = Path(os.environ.get("LOCALAPPDATA", home / "AppData/Local"))
        cache_paths = [local / "Temp",
                       home / "AppData/Roaming/Adobe/Common/Media Cache",
                       home / "AppData/Roaming/Adobe/Common/Media Cache Files",
                       home / "AppData/Roaming/Adobe/Common/Peak Files"]
    else:
        cache_paths = [home / ".cache"]

    for path in home.rglob(".DS_Store"):
        if path.is_file() and not path.is_symlink():
            try:
                remove(path, dry_run)
            except OSError as error:
                print(f"❌ Could not remove {path}: {error}", file=sys.stderr)
                failed = True
    for cache in cache_paths:
        if not cache.is_dir():
            continue
        children = list(cache.iterdir())
        if sys.platform == "darwin" and cache.name == "Caches":
            children = [child for child in children if child.name != "Homebrew"]
        for child in children:
            try:
                remove(child, dry_run)
            except OSError as error:
                print(f"❌ Could not remove {child}: {error}", file=sys.stderr)
                failed = True
    print("⚠️ System maintenance had errors." if failed else "✅ System maintenance complete.")
    return not failed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--system", action="store_true", help="clean user system caches")
    parser.add_argument("--dry-run", action="store_true", help="report changes without applying")
    parser.add_argument("volumes", nargs="*", type=Path, help="mounted volume roots to clean")
    args = parser.parse_args()
    if not args.system and not args.volumes:
        args.system = True
    succeeded = True
    for target in args.volumes:
        succeeded &= clean_volume(target, args.dry_run)
    if args.system:
        succeeded &= clean_system(args.dry_run)
    return 0 if succeeded else 1


if __name__ == "__main__":
    sys.exit(main())
