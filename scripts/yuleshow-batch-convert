#!/usr/bin/env python3
"""Batch-convert files in the current directory with ffmpeg."""

import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 3:
        print("Usage: yuleshow-batch-convert <old_ext> <new_ext>", file=sys.stderr)
        return 1
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        print("ffmpeg not found", file=sys.stderr)
        return 1

    old_ext, new_ext = (value.lstrip(".") for value in sys.argv[1:])
    if not old_ext or not new_ext:
        print("Extensions must not be empty.", file=sys.stderr)
        return 1

    inputs = sorted(path for path in Path.cwd().iterdir()
                    if path.is_file() and path.suffix[1:].casefold() == old_ext.casefold())
    print(f"🚀 Converting *.{old_ext} -> *.{new_ext} in: {Path.cwd()}")
    failed = False
    for source in inputs:
        target = source.with_suffix(f".{new_ext}")
        result = subprocess.run(
            [ffmpeg, "-hide_banner", "-loglevel", "error", "-n", "-i", str(source), str(target)],
            check=False,
        )
        if result.returncode:
            print(f"❌ Failed: {source}", file=sys.stderr)
            failed = True
        else:
            print(f"✅ {source} -> {target}")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
