#!/usr/bin/env python3
"""Convert AVIF images to PNG using Pillow's AVIF plugin."""

import argparse
import sys
from pathlib import Path

from PIL import Image
import pillow_avif  # noqa: F401


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="recursively process directories")
    parser.add_argument("-o", "--out-dir", type=Path,
                        help="write all output files to this directory")
    parser.add_argument("-f", "--force", action="store_true",
                        help="overwrite existing PNG files")
    parser.add_argument("inputs", nargs="+", type=Path, help="AVIF files or directories")
    args = parser.parse_args()

    if args.out_dir:
        args.out_dir.mkdir(parents=True, exist_ok=True)
    failed = False

    def convert(source: Path) -> None:
        nonlocal failed
        if not source.is_file() or source.suffix.casefold() != ".avif":
            return
        target_dir = args.out_dir or source.parent
        target = target_dir / f"{source.stem}.png"
        if target.exists() and not args.force:
            print(f"Skip: {target} already exists (use -f to overwrite)")
            return
        try:
            with Image.open(source) as image:
                image.save(target, "PNG")
            print(f"Converted: {source} -> {target}")
        except (OSError, ValueError) as error:
            print(f"Error converting {source}: {error}", file=sys.stderr)
            failed = True

    for item in args.inputs:
        if item.is_file():
            convert(item)
        elif item.is_dir():
            candidates = item.rglob("*") if args.recursive else item.iterdir()
            for candidate in sorted(candidates):
                convert(candidate)
        else:
            print(f"Warning: not found, skipping: {item}", file=sys.stderr)
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
