#!/usr/bin/env python3
"""Convert JPEG files to PNG with ffmpeg."""

import argparse
import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-d", "--delete", action="store_true",
                        help="delete each original after a successful conversion")
    parser.add_argument("target", type=Path, help="JPEG file or directory")
    args = parser.parse_args()

    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        print("ffmpeg is required but was not found on PATH.", file=sys.stderr)
        return 1
    if args.target.is_file():
        inputs = [args.target] if args.target.suffix.casefold() in (".jpg", ".jpeg") else []
        if not inputs:
            print(f"Error: '{args.target}' does not appear to be a JPEG/JPG file.",
                  file=sys.stderr)
            return 1
    elif args.target.is_dir():
        inputs = sorted(path for path in args.target.rglob("*")
                        if path.is_file() and path.suffix.casefold() in (".jpg", ".jpeg"))
    else:
        print(f"Error: '{args.target}' is not a valid file or directory.", file=sys.stderr)
        return 1

    if not inputs:
        print(f"No JPEG/JPG files found in: {args.target}")
        return 0

    failed = False
    for source in inputs:
        target = source.with_suffix(".png")
        print(f"Converting: '{source}' -> '{target}'")
        result = subprocess.run(
            [ffmpeg, "-v", "error", "-n", "-i", str(source), str(target)],
            check=False,
        )
        if result.returncode:
            print(f"Error: Failed to convert '{source}'", file=sys.stderr)
            failed = True
            continue
        if args.delete:
            source.unlink()
            print(f"Deleted original: '{source}'")
    print("Done!")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
