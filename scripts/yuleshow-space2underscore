#!/usr/bin/env python3
"""Replace spaces with underscores in names in the current directory."""

import os
import sys
from pathlib import Path


def main() -> int:
    print(f"🚀 Replacing spaces with underscores under: {Path.cwd()}")
    failed = False
    for source in sorted(Path.cwd().iterdir()):
        if " " not in source.name:
            continue
        target = source.with_name(source.name.replace(" ", "_"))
        if os.path.lexists(target):
            print(f"⚠️ Skip '{source}' (target '{target}' exists)", file=sys.stderr)
            continue
        try:
            source.rename(target)
            print(f"✅ {source.name} -> {target.name}")
        except OSError as error:
            print(f"❌ {source}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
