#!/usr/bin/env python3
"""Convert MP3 files in the current directory to mono."""

import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        print("ffmpeg not found", file=sys.stderr)
        return 1

    print(f"🚀 Converting mp3 to mono in: {Path.cwd()}")
    failed = False
    for source in sorted(Path.cwd().iterdir()):
        if not source.is_file() or source.suffix.casefold() != ".mp3":
            continue
        if source.stem.casefold().endswith("-mono"):
            continue
        target = source.with_name(f"{source.stem}-mono.mp3")
        result = subprocess.run(
            [ffmpeg, "-hide_banner", "-loglevel", "error", "-n", "-i", str(source),
             "-ac", "1", str(target)],
            check=False,
        )
        if result.returncode:
            print(f"❌ Failed: {source}", file=sys.stderr)
            failed = True
        else:
            print(f"✅ {source} -> {target}")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
